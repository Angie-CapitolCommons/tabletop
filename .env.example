# Server-side only. Never expose to the client (PRD acceptance criterion).
ANTHROPIC_API_KEY=

# Required: four distinct comma-separated room codes and a separate admin code.
# No default codes are accepted.
ROOM_CODES=
ADMIN_CODE=

# Required: PostgreSQL (sessions are never kept only in memory).
DATABASE_URL=

# Optional overrides
# MODEL=claude-opus-5
# PORT=4600
# NPC_FIRST_TOKEN_TIMEOUT_MS=8000
