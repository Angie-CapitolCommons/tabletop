# Server-side only. Never expose to the client (PRD acceptance criterion).
ANTHROPIC_API_KEY=

# Access codes (PRD §4: five logins in the world). Defaults shown; override
# before the session. Four comma-separated room codes, one admin code.
# ROOM_CODES=OAK-1,ELM-2,ASH-3,FIR-4
# ADMIN_CODE=DUARTE-LEAD

# Persistence: set by Replit's Postgres automatically. Without it, state is
# in-memory (fine for local dev; lost on restart).
# DATABASE_URL=

# Optional overrides
# MODEL=claude-opus-5
# PORT=4600
# NPC_FIRST_TOKEN_TIMEOUT_MS=8000
